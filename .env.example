# Local development only.
# In Render, add these under Environment Variables instead.

NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLIENT_ORIGIN=http://localhost:5173

# Free-tier-first AI Scenario Coach settings.
# Keep keys server-side only. Never expose these in React/Vite frontend env vars.
# auto = try Gemini first, then Groq, then built-in fallback.
AI_PROVIDER=auto
GEMINI_API_KEY=your_rotated_gemini_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_rotated_groq_key
GROQ_MODEL=llama-3.1-8b-instant
