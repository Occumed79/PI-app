# Local development only.
# In Render, add these under Environment Variables instead.

NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLIENT_ORIGIN=http://localhost:5173

# Optional AI Scenario Coach settings.
# Keep this server-side only. Never expose this in React/Vite frontend env vars.
OPENAI_API_KEY=sk-your-server-side-key
OPENAI_MODEL=gpt-4.1-mini
